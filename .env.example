# Google Apps Script Web App URL (Deploy → Web app → Anyone → /exec)
GOOGLE_SHEETS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Vercel: add GOOGLE_SHEETS_URL in Project → Settings → Environment Variables, then redeploy.
# Local dev: copy to .env — either GOOGLE_SHEETS_URL or VITE_GOOGLE_SHEETS_URL works.
